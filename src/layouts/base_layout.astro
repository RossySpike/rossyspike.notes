---
import Header from '../components/header.astro';
import Footer from '../components/footer.astro';
import ContentList from '../components/content_list.astro'
import '../styles/global.css';
const {pageTitle} = Astro.props
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
	</head>
	<body>
    <header>
      <Header id='header' />
    </header>
    <div id='container'>
      <aside class='index'>
        <p style='margin:0;'>indice</p>
        <hr/>
        <ContentList />
      </aside>
      <main>
        <h1>{pageTitle}</h1>
        <slot/>
        <Footer/>
      </main>
    </div>
    <script>
      import "../scripts/menu.js";
    </script>
	</body>
</html>
<style>
body {
    margin-left:0;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    padding:0;
    min-width: 75%;

}
header {
  background-color: #23262f;
  width: 100dvw;
  position: fixed;


}
  /* TODO: Aca agregar codigo para que la barra lateral se pueda quitar */
aside{

  background-color: #23262f;
  padding: 10px;
  position: fixed;
  overflow-y:scroll;
      inset-block: 3rem 0; /* TODO: $1 a var */
}
aside :global(#category-list){
  
    font-size: 1.25rem;
}
aside :global(#post-list){
  
      font-size: .875rem;
}
main {
  margin-top:2.2em; /*TODO: cambiar a var*/
}
@media (width >= 50rem){

  #container {
    display: flex;
    flex-wrap: nowrap;
    flex-grow: 1;

    & > aside {
      width: 20%;
      max-width: 170px;
      inset-block: 4rem 0; /* TODO: $1 a var */
    }
    
  }
  main {
    width: 80%;
    margin-left:13rem; /* TODO: $1 a var */
  }
}
@media (width < 50rem){
  
  #container > aside {
    display: none;
  }
}

</style>
