---
import Navigation from './navigation.astro'
import Menu from './menu.astro'
---
<header>
  <div>
    <img src='/rys-gh-user.png'/>
    <nav>
      <Navigation/>
    </nav>
  </div>
  <Menu/>
</header>
<style>
  header {
    display: flex;
    padding:5px;
    justify-content: space-between;
  }
  img {
    max-height: 100%;
    max-width:2rem;
    margin:0;
  }
  div{
    display:flex;
    align-items: center;
    gap:5px;
    justify-content: left;

  }
</style>
